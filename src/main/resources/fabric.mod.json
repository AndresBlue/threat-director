{
  "schemaVersion": 1,
  "id": "threatdirector",
  "version": "${version}",
  "name": "Threat Director",
  "description": "Encuentros hostiles coordinados, adaptativos y tácticamente peligrosos.",
  "authors": [
    "AndresBlue"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.andresblue.threatdirector.ThreatDirectorMod"
    ],
    "client": [
      "com.andresblue.threatdirector.ThreatDirectorClient"
    ],
    "threatdirector-api-v1": [
      "com.andresblue.threatdirector.api.v1.ThreatDirectorApiProvider"
    ]
  },
  "mixins": [
    "threatdirector.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabric-api": ">=0.92.11"
  }
}
